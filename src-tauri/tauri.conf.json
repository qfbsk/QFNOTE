{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "清枫速记",
  "version": "2.7.1",
  "identifier": "com.qfbsk.qfnote",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "清枫速记",
        "width": 326,
        "height": 480,
        "minWidth": 326,
        "minHeight": 280,
        "x": 50,
        "y": 50,
        "transparent": true,
        "resizable": true,
        "visible": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "mimeType": "text/markdown",
        "name": "清枫速记"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}